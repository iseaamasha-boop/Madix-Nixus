Options -Indexes
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    # نسخ مضغوطة مسبقاً بجانب الملفات النصية (يبنيها التثبيت والتحديث): brotli ثم gzip، فلا يُضغط الملف مع كل طلب
    RewriteCond %{HTTP:Accept-Encoding} \bbr\b
    RewriteCond %{REQUEST_FILENAME}.br -f
    RewriteRule ^(assets/.+\.(?:css|js|svg|json))$ $1.br [L]
    RewriteCond %{HTTP:Accept-Encoding} \bgzip\b
    RewriteCond %{REQUEST_FILENAME}.gz -f
    RewriteRule ^(assets/.+\.(?:css|js|svg|json))$ $1.gz [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L,QSA]
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|svg|woff2|png|jpg|jpeg|webp|gif|ico)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    <FilesMatch "\.(css|js|svg|json)$">
        Header merge Vary Accept-Encoding
    </FilesMatch>
    <FilesMatch "\.(css|js|svg|json)\.(br|gz)$">
        Header set Cache-Control "public, max-age=604800"
        Header append Vary Accept-Encoding
    </FilesMatch>
    <FilesMatch "\.(css|js|svg|json)\.br$">
        Header set Content-Encoding br
    </FilesMatch>
    <FilesMatch "\.(css|js|svg|json)\.gz$">
        Header set Content-Encoding gzip
    </FilesMatch>
</IfModule>
<IfModule mod_env.c>
    # النسخة المضغوطة مسبقاً لا تُضغط مرة ثانية (المتغير يُضبط على الملف نفسه بعد التحويل الداخلي إليه)
    <FilesMatch "\.(css|js|svg|json)\.(br|gz)$">
        SetEnv no-gzip 1
        SetEnv no-brotli 1
    </FilesMatch>
</IfModule>
<IfModule mod_mime.c>
    # نوع الملف الأصلي للنسخة المضغوطة
    <FilesMatch "\.css\.(br|gz)$">
        ForceType text/css
    </FilesMatch>
    <FilesMatch "\.js\.(br|gz)$">
        ForceType text/javascript
    </FilesMatch>
    <FilesMatch "\.svg\.(br|gz)$">
        ForceType image/svg+xml
    </FilesMatch>
    <FilesMatch "\.json\.(br|gz)$">
        ForceType application/json
    </FilesMatch>
    RemoveEncoding .gz .br
    RemoveLanguage .br
</IfModule>
